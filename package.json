{
  "name": "shopforge",
  "version": "1.0.0",
  "description": "ShopForge \u2014 Production-ready Shopify App Starter Kit",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": ["landing"],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "postinstall": "node scripts/setup-db.cjs && prisma generate",
    "setup": "node scripts/setup-db.cjs",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:seed": "tsx scripts/seed.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:raw": "shopify app dev",
    "start": "node server.mjs",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write \"app/**/*.{ts,tsx,json,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "check": "tsx scripts/check.ts",
    "generate": "tsx scripts/generate.ts",
    "functions:setup": "tsx scripts/setup-functions.ts",
    "clean:demo": "tsx scripts/clean-demo.ts",
    "landing:dev": "npm --workspace=landing run dev",
    "landing:build": "npm --workspace=landing run build",
    "landing:start": "npm --workspace=landing run start"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@remix-run/express": "^2.17.5",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@shopify/app-bridge-react": "^4.2.12",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-api": "^11.6.0",
    "@shopify/shopify-app-remix": "^3.6.0",
    "@shopify/shopify-app-session-storage-prisma": "^5.1.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.34.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
