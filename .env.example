# ShopForge Environment Variables
# Run `npm run setup` for interactive configuration, or copy this file and edit.
# Note: `npm run dev` will auto-run setup if .env is missing.

# === Shopify App Credentials ===
# Get from: https://partners.shopify.com → Apps → Configuration → API credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# === Database ===
# Default: SQLite (zero config). Run `npm run setup -- --provider postgresql` to switch.
#   SQLite:       file:./dev.db
#   PostgreSQL:   postgresql://user:password@localhost:5432/shopforge
#   MySQL:        mysql://user:password@localhost:3306/shopforge
DATABASE_URL=file:./dev.db

# === Security (auto-generated by `npm run setup`) ===
ENCRYPTION_KEY=
CSRF_SECRET=

# === Optional ===
APP_URL=http://localhost:3000
SHOPIFY_SCOPES=
SHOPIFY_BILLING_TEST=true
LOG_LEVEL=debug
RESEND_API_KEY=
RESEND_FROM_EMAIL=ShopForge <onboarding@resend.dev>
REDIS_URL=
CRON_SECRET=
