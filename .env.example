# ShopForge Environment Variables
# Copy this file to .env and fill in the values

# === Required (4 values to get started) ===

# Shopify App credentials (from Partner Dashboard)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Database connection
# Run `npm run setup` to auto-configure, or choose one below:
#
#   PostgreSQL:  postgresql://user:password@localhost:5432/shopforge
#   MySQL:       mysql://user:password@localhost:3306/shopforge
#   SQLite:      file:./dev.db
#
DATABASE_URL=file:./dev.db

# Encryption key for tokens (AES-256-GCM, required for session security)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# === Optional ===

# App URL (auto-detected by Shopify CLI in development)
APP_URL=http://localhost:3000

# Override API scopes (comma-separated, defaults to shopify.server.ts APP_SCOPES)
SHOPIFY_SCOPES=

# Billing test mode (set to "false" for real charges, default: test mode)
SHOPIFY_BILLING_TEST=true

# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# Resend API key for transactional emails (welcome, billing notifications)
# Get your key at https://resend.com — free tier: 100 emails/day
# Leave empty to mock emails in development (logs instead of sending)
RESEND_API_KEY=

# Sender email for outbound emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=ShopForge <onboarding@resend.dev>

# Redis URL for multi-process rate limiting (production recommended)
# Leave empty to use in-memory rate limiting (single-process only)
REDIS_URL=

# Cron secret for protecting the /health?detail=1 diagnostic endpoint
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=

# CSRF protection secret for signing form tokens
# Defaults to SESSION_SECRET if not set; generate a unique value for production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
