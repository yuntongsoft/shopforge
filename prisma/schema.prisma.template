generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "__PROVIDER__"
  url      = env("DATABASE_URL")
}

/// Shop — stores OAuth tokens, plan status, and app state
model Shop {
  id            String    @id @default(uuid())
  shopifyDomain String    @unique @map("shopify_domain")
  shopifyToken  String    @map("shopify_token")
  shopifyScope  String    @default("") @map("shopify_scope")
  plan          String    @default("free")
  subscriptionId String? @map("subscription_id")
  subscriptionStatus String @default("NONE") @map("subscription_status")
  subscriptionCheckedAt DateTime? @map("subscription_checked_at")
  initializedAt DateTime? @map("initialized_at")
  installationId String @default(uuid()) @map("installation_id")
  pendingSubscriptionId String? @map("pending_subscription_id")
  pendingPlan String? @map("pending_plan")
  pendingConfirmation String? @map("pending_confirmation")
  merchantEmail String    @default("") @map("merchant_email")
  locale        String    @default("en")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  orders        Order[]
  shopFunctions ShopFunction[]
  webhookConfigs WebhookConfig[]

  // NOTE: plan and isDeleted are low-cardinality — single-column indexes are wasteful.
  // Composite indexes provide better selectivity for common query patterns.
  @@index([plan, isDeleted])
  @@index([isDeleted, updatedAt])
  @@map("shops")
}

/// Session — OAuth session storage (managed by @shopify/shopify-app-session-storage-prisma)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false) @map("is_online")
  scope               String?
  expires             DateTime?
  accessToken         String    @map("access_token")
  userId              BigInt?   @map("user_id")
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false) @map("account_owner")
  locale              String?
  collaborator        Boolean   @default(false)
  emailVerified       Boolean   @default(false) @map("email_verified")
  refreshToken        String?   @map("refresh_token")
  refreshTokenExpires DateTime? @map("refresh_token_expires")
  credentialVersion   Int       @default(0) @map("credential_version")
  refreshLeaseId      String?   @map("refresh_lease_id")
  refreshLeaseUntil   DateTime? @map("refresh_lease_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // SDK writes Session before creating Shop, so no forward foreign key established.

  @@index([shop])
  @@map("sessions")
}

/// Order — example business model (replace with your real feature via code generator)
model Order {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  orderNumber String   @default("") @map("order_number")
  customer    String   @default("")
  customerId  String?  @map("customer_id")
  externalOrderId String? @map("external_order_id")
  // NOTE: Float used for cross-database compatibility (PostgreSQL/MySQL/SQLite).
  // For production PostgreSQL/MySQL, prefer: Decimal @db.Decimal(18, 2)
  amount      Float    @default(0)
  status      String   @default("pending")
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // shopId is already covered by the composite [shopId, createdAt] index below
  @@index([shopId, createdAt])
  @@map("orders")
}

/// ShopFunction — maps business rule types to deployed Shopify Function GIDs.
/// Managed by function-registry.ts — developers never touch this directly.
/// Scoped per-shop for multi-tenant isolation.
model ShopFunction {
  id         String   @id @default(uuid())
  shopId     String   @map("shop_id")
  ruleType   String   @map("rule_type")
  functionId String   @map("function_id")
  label      String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, ruleType])
  // shopId is already covered by the unique [shopId, ruleType] constraint
  @@map("shop_functions")
}

/// Business operation short-term lease; network calls executed outside transaction.
model OperationLease {
  key String @id
  owner String
  expiresAt DateTime @map("expires_at")
  @@map("operation_leases")
}

model WebhookExecution {
  id String @id @default(uuid())
  shop String
  webhookId String @map("webhook_id")
  topic String
  handlerId String @map("handler_id")
  status String @default("PENDING")
  attempts Int @default(0)
  leaseId String? @map("lease_id")
  leaseUntil DateTime? @map("lease_until")
  triggeredAt DateTime? @map("triggered_at")
  traceId String @map("trace_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([shop, webhookId, handlerId])
  @@index([shop, createdAt])
  @@map("webhook_executions")
}

model PrivacyRequest {
  id String @id @default(uuid())
  shop String
  webhookId String @map("webhook_id")
  kind String
  status String @default("PENDING")
  sealedPayload String? @map("sealed_payload")
  expiresAt DateTime @map("expires_at")
  completedAt DateTime? @map("completed_at")
  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String? @map("confirmed_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([shop, webhookId])
  @@index([shop, createdAt])
  @@map("privacy_requests")
}

/// WebhookJob — async queue for heavy webhook processing.
/// Route receives webhook → persists job (pending) → returns 200 immediately.
/// setImmediate / cron consumes: CAS claim → process → mark completed/failed.
/// Idempotent dedup via @@unique([topic, shopDomain, webhookId]): Shopify retries
/// the same event with the same X-Shopify-Webhook-Id, dedup silently ignores it.
model WebhookJob {
  id          String   @id @default(uuid())
  topic       String
  shopDomain  String   @map("shop_domain")
  webhookId   String?  @map("webhook_id")
  payload     String   // JSON string — stored as text for cross-DB compatibility
  status      String   @default("pending") // pending | processing | completed | failed
  attempts    Int      @default(0)
  lastError   String?  @map("last_error")
  retryAfter  DateTime? @map("retry_after")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Idempotent dedup: same topic + shop + webhookId = duplicate event from Shopify retry
  @@unique([topic, shopDomain, webhookId])
  // Consumer queries: [status + createdAt] for pending jobs, [status + updatedAt] for lease recovery
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([shopDomain])
  @@map("webhook_jobs")
}

/// WebhookConfig — outbound event push configuration.
/// Merchants register a URL + secret to receive real-time events (e.g. rule.created).
/// SSRF guard validates URL before delivery; HMAC-SHA256 signs each payload.
model WebhookConfig {
  id        String   @id @default(uuid())
  shopId    String   @map("shop_id")
  url       String
  secret    String   // HMAC signing key (generated by generateWebhookSecret())
  events    String   @default("[]") // JSON array of event strings, e.g. ["rule.created","rule.updated"]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, isActive])
  @@map("webhook_configs")
}
